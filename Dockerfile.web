# Multi-stage build for the Next.js frontend. Produces a minimal runtime
# image via Next's "standalone" output (see next.config.mjs) — the final
# stage needs no node_modules at all, just the traced server + static assets.

# ---- deps: install once, reused by the builder stage's cache layer ----
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ---- builder: full source + a real `next build` ----
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# No NEXT_PUBLIC_SOCKET_URL build arg needed for the normal case: `next
# build` always forces NODE_ENV=production, and SocketContext.tsx uses
# that (not an env var) to default to a same-origin connection through
# nginx — see its comment for why an empty-string build arg doesn't work
# for this (Next.js doesn't inline NEXT_PUBLIC_* vars set to ""). This ARG
# only exists as an escape hatch for a genuinely non-same-origin
# deployment: `docker build --build-arg NEXT_PUBLIC_SOCKET_URL=<real-url>`.
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
RUN npm run build

# ---- runner: just the standalone server + static assets ----
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/public ./public
# .next/standalone already includes a minimal server.js entrypoint plus
# only the node_modules files it actually traced as needed.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
