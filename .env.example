# Copy to .env and adjust as needed — docker-compose.yml reads these
# automatically. Neither is required; both have sane local defaults.

# Host port nginx binds to. Default: 80.
HTTP_PORT=80

# Origin the Socket.IO server accepts CORS connections from (must match
# whatever public URL the app is actually served at once deployed — a
# real domain/TLS setup is a deploy-time decision, not resolved here).
# Default: http://localhost
CLIENT_ORIGIN=http://localhost
